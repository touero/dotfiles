anchor=top-center
layer=overlay
# on-notify=exec timeout 5s mpv --no-video --no-terminal --quiet --keep-open=no /usr/share/sounds/freedesktop/stereo/message.oga
on-notify=exec timeout 5s pw-play /usr/share/sounds/freedesktop/stereo/message.oga

width=500
height=150
padding=10

icons=1
icon-location=left

font=Iosevka Nerd Font Mono 13
text-color=#fbf1c7
background-color=#3c3836
markup=1
text-alignment=center

default-timeout=7000
max-visible=5

border-size=2
border-radius=8

[urgency=low]
border-color=#98971d

[urgency=normal]
border-color=#d79921

[urgency=critical]
border-color=#cc241d
