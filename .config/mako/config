anchor=top-center
layer=overlay
# on-notify=exec timeout 5s mpv --no-video --no-terminal --quiet --keep-open=no /usr/share/sounds/freedesktop/stereo/message.oga
on-notify=exec timeout 5s pw-play /usr/share/sounds/freedesktop/stereo/message.oga

width=500
padding=10

font=Monospace 12
text-color=#ebdbb2
background-color=#282828
markup=1
text-alignment=center

default-timeout=7000
max-visible=5

border-size=1
border-color=#b8bb26

[urgency=low]
border-color=#a89984

[urgency=normal]
border-color=#b8bb26

[urgency=high]
border-color=#fb4934
