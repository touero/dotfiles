#!/usr/bin/env bash
# $HOME/.local/bin/loading
# @Author: weiensong(touero) <ensongwei@gmail.com>
# @Since: 2026
# @Description: loading style in terminal
# Usage:
#     source "$HOME/.local/bin/loading"
#
#     tmp=$(mktemp)
#
#     curl -s wttr.in >"$tmp" &
#     loading "$!" "get local weather"
#
#     result=$(cat "$tmp")
#     rm -f "$tmp"
#
#     echo "$result"

loading() {
  local pid="$1"
  local text="${2:-}"
  local chars='|/-\'
  local i=0

  local green='\033[32m'
  local red='\033[31m'
  local reset='\033[0m'

  while kill -0 "$pid" 2>/dev/null; do
    printf "\r%s %s" "${chars:i++%4:1}" "$text"
    sleep 0.1
  done

  wait "$pid"
  local status=$?

  if [ "$status" -eq 0 ]; then
    printf "\r${green}[OK]${reset} %s\n" "$text"
  else
    printf "\r${red}[FAIL]${reset} %s\n" "$text"
  fi

  return "$status"
}
