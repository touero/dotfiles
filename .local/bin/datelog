#!/usr/bin/env bash
# @author touero
# @since 2025
# datelog: choice date style in menu

source "$HOME/.local/bin/get_clipboard"

CLIPBOARD=$(get_clipboard)

fmt_choice=$(
  printf '%s\n%s\n' \
    "Underline" \
    "Horizontal Line" |
    "$HOME/.local/bin/menu" show -l 2 -p "date format"
)

[ -z "$fmt_choice" ] && exit 0

if [[ "$fmt_choice" == *"Underline"* ]]; then
  date_fmt="+%Y_%m_%d"
else
  date_fmt="+%Y-%m-%d"
fi

choice=$(
  for ((i = 0; i < 180; i++)); do
    date -d "-$i day" "$date_fmt"
  done | "$HOME/.local/bin/menu" show -l 30 -p "copy to clipboard"
)

if [ -n "$choice" ]; then
  printf '%s' "$choice" | "$CLIPBOARD"
  focus_point
fi
